		<properties node_id="19" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': None, 'scriptLibrary': [{'name': 'Top coefficients', 'script': '# Keep the 5 most positive and the 5 most negative coefficients\n# of the linear regression model (the intercept is not a feature,\n# so it is left out of the ranking).\nimport numpy as np\n\ncoef = in_data.get_column("coef")\nnames = [str(n) for n in in_data.get_column("name")]\nrows = np.array([i for i, n in enumerate(names) if n != "intercept"])\norder = rows[np.argsort(coef[rows], kind="stable")]\ntop_positive = order[::-1][:5]\ntop_negative = order[:5]\nout_data = in_data[np.concatenate([top_positive, top_negative])]\nout_data.name = "Top 5 positive / top 5 negative coefficients"\n', 'filename': None}], 'scriptText': '# Keep the 5 most positive and the 5 most negative coefficients\n# of the linear regression model (the intercept is not a feature,\n# so it is left out of the ranking).\nimport numpy as np\n\ncoef = in_data.get_column("coef")\nnames = [str(n) for n in in_data.get_column("name")]\nrows = np.array([i for i, n in enumerate(names) if n != "intercept"])\norder = rows[np.argsort(coef[rows], kind="stable")]\ntop_positive = order[::-1][:5]\ntop_negative = order[:5]\nout_data = in_data[np.concatenate([top_positive, top_negative])]\nout_data.name = "Top 5 positive / top 5 negative coefficients"\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xbc\x00\x00\x00z\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
