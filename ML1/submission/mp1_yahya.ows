		<properties node_id="13" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': None, 'scriptLibrary': [{'name': 'Top 10 correlations', 'script': '# Keep the 10 feature pairs with the strongest Pearson correlation.\n# "Strongest" = largest absolute value, so strong negative\n# correlations are kept as well as strong positive ones.\nimport numpy as np\n\nr = in_data.get_column("Correlation")\norder = np.argsort(-np.abs(r), kind="stable")[:10]\nout_data = in_data[order]\nout_data.name = "Top 10 correlations with Arrest"\n', 'filename': None}], 'scriptText': '# Keep the 10 feature pairs with the strongest Pearson correlation.\n# "Strongest" = largest absolute value, so strong negative\n# correlations are kept as well as strong positive ones.\nimport numpy as np\n\nr = in_data.get_column("Correlation")\norder = np.argsort(-np.abs(r), kind="stable")[:10]\nout_data = in_data[order]\nout_data.name = "Top 10 correlations with Arrest"\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xbc\x00\x00\x00z\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
