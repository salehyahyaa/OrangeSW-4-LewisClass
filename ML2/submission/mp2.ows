<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="MP2 - Classification and Clustering (Breast Cancer Wisconsin)" description="Clusters the Breast Cancer Wisconsin data with k-Means and hierarchical clustering, compares the clusters with the real labels, and trains models that predict the type of tumor.">
